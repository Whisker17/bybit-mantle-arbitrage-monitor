# systemd template unit: live collector for one market (M7-2 / WHI-771).
#
# Install on the VPS:
#   sudo cp deploy/xstocks-collector@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xstocks-collector@bybit-fluxion
#   # later:
#   sudo systemctl enable --now xstocks-collector@binance-pancake
#
# Instance name (%i) is the market id (config/markets/%i.yaml +
# collector.yaml markets.%i). Journal: data/monitor-%i.db
#
# Adjust User/WorkingDirectory/Environment to match the deploy layout.

[Unit]
Description=xStocks arbitrage monitor collector (%i)
After=network.target

[Service]
Type=simple
User=xstocks
Group=xstocks
WorkingDirectory=/opt/xstocks/app
Environment=PATH=/opt/xstocks/app/.venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
# Optional keyed Mantle / BSC RPC in /opt/xstocks/app/.env (loaded by the process).
ExecStart=/opt/xstocks/app/.venv/bin/python -m monitor.collector --market %i
# WHI-825: always restart (kill -9, OOM, watchdog non-zero exit, clean stop
# from an operator still leaves the unit wanted — use stop/disable to halt).
Restart=always
RestartSec=3
# Collector holds WS + RPC; leave headroom on the 1GB box for API + nginx.
MemoryMax=400M
MemoryHigh=320M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
