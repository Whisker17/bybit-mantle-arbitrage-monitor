# Copy to .env and fill in real values. Never commit .env.
# Secrets only (credentials, keys, webhook URLs) — tunable parameters belong in
# config/*.yaml, not here.

# Keyed Mantle endpoint. Supplied as wss://wss-tob.mantle.xyz/v1/<key>; the code
# rewrites it to the https://rpc-tob.mantle.xyz/v1/<key> equivalent.
# Optional — without it the code falls back to the public https://rpc.mantle.xyz,
# which caps eth_getLogs at 10k blocks and throttles aggressively.
MANTLE_RPC_URL=

# Issue tracker — only needed when your agent runtime has no Linear MCP server and
# must fall back to the GraphQL API (docs/agents/issue-tracker.md, rung 2).
# LINEAR_API_KEY=
