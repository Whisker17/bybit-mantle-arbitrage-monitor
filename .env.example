# Keyed Mantle endpoint. Supplied as wss://wss-tob.mantle.xyz/v1/<key>; the code
# rewrites it to the https://rpc-tob.mantle.xyz/v1/<key> equivalent.
# Optional -- without it the code falls back to the public https://rpc.mantle.xyz,
# which caps eth_getLogs at 10k blocks and throttles aggressively.
MANTLE_RPC_URL=
